# Data Cleaning Part 1c
# 1. Create a new, clean dataset for modeling
bronx_clean <- bronx_data %>%
# Convert square foot columns to numeric
# as.numeric() will force any non-number text into NA
mutate(
GROSS.SQUARE.FEET = as.numeric(GROSS.SQUARE.FEET),
LAND.SQUARE.FEET = as.numeric(LAND.SQUARE.FEET)
) %>%
# 2. Filter out non-sales and create log_price
filter(SALE.PRICE > 1000) %>%
mutate(log_price = log(SALE.PRICE)) %>%
# 3. Select only the variables we'll use for the model
dplyr::select(
log_price,
GROSS.SQUARE.FEET,
LAND.SQUARE.FEET,
YEAR.BUILT,
RESIDENTIAL.UNITS,
COMMERCIAL.UNITS,
NEIGHBORHOOD,
BUILDING.CLASS.CATEGORY
) %>%
# 4. Drop any remaining rows with missing data (NAs)
na.omit()
View(bronx_clean)
# Check the new, clean data
glimpse(bronx_clean)
summary(bronx_clean)
reg_model <- lm(log_price ~., data = bronx_clean)
